{
  "name": "no-paper-needed",
  "version": "0.0.0",
  "private": true,
  "description": "",
  "keywords": [],
  "main": "app/main.js",
  "scripts": {
    "build": "npm run electron:serve-tsc && ng build --base-href ./",
    "chores": "npm run lint:fix && npm run format",
    "e2e": "npm run web:prod && playwright test -c e2e/playwright.config.ts e2e/",
    "e2e:show-trace": "playwright show-trace e2e/tracing/trace.zip",
    "electron": "electron",
    "electron:build": "npm run web:prod && electron-builder build --publish=never",
    "electron:local": "npm run web:dev && electron .",
    "electron:serve": "wait-on tcp:4200 && npm run electron:serve-tsc && electron . --serve",
    "electron:serve-tsc": "tsc -p tsconfig.serve.json",
    "format": "sort-package-json \"**/package.json\" && prettier --w **/*.json src/**/*.{ts,html,scss}",
    "postinstall": "electron-builder install-app-deps",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "ng": "ng",
    "ng:serve": "ng serve -o",
    "start": "npm-run-all -p electron:serve ng:serve",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "version": "conventional-changelog -i CHANGELOG.md -s -r 0 && git add CHANGELOG.md",
    "web:dev": "npm run build",
    "web:prod": "npm run build -- -c production"
  },
  "browserslist": [
    "chrome 140"
  ],
  "dependencies": {
    "@angular/common": "21.0.3",
    "@angular/compiler": "21.0.3",
    "@angular/core": "21.0.3",
    "@angular/forms": "21.0.3",
    "@angular/language-service": "21.0.3",
    "@angular/platform-browser": "21.0.3",
    "@angular/platform-browser-dynamic": "21.0.3",
    "@angular/router": "21.0.3",
    "@primeuix/themes": "2.0.2",
    "primeicons": "7.0.0",
    "primeng": "21.0.2",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.16.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "21.0.1",
    "@angular-eslint/eslint-plugin": "21.0.1",
    "@angular-eslint/eslint-plugin-template": "21.0.1",
    "@angular-eslint/schematics": "21.0.1",
    "@angular-eslint/template-parser": "21.0.1",
    "@angular/build": "21.0.2",
    "@angular/cli": "21.0.2",
    "@angular/compiler-cli": "21.0.3",
    "@chris.araneo/eslint-config": "0.0.76",
    "@eslint/json": "0.14.0",
    "@ngx-translate/core": "17.0.0",
    "@ngx-translate/http-loader": "17.0.0",
    "@playwright/test": "1.57.0",
    "@types/node": "22.19.1",
    "@typescript-eslint/eslint-plugin": "8.48.1",
    "@typescript-eslint/parser": "8.48.1",
    "@vitest/browser-playwright": "4.0.15",
    "@vitest/coverage-v8": "4.0.15",
    "@vitest/ui": "4.0.15",
    "angular-eslint": "21.1.0",
    "conventional-changelog": "7.1.1",
    "electron": "39.2.5",
    "electron-builder": "26.0.12",
    "electron-debug": "4.1.0",
    "electron-reloader": "1.2.3",
    "eslint": "9.39.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "61.4.1",
    "eslint-plugin-jsonc": "2.21.0",
    "eslint-plugin-prefer-arrow": "1.2.3",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "jsdom": "27.2.0",
    "jsonc-eslint-parser": "2.4.2",
    "npm-run-all": "4.1.5",
    "playwright": "1.57.0",
    "prettier": "3.7.4",
    "sort-package-json": "3.6.0",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.51.0",
    "vitest": "4.0.15",
    "wait-on": "9.0.3",
    "webdriver-manager": "13.0.2"
  },
  "engines": {
    "node": ">= 22.12.0 || >= 24.0.0",
    "typescript": ">= 5.8.0 < 5.9.0"
  }
}
