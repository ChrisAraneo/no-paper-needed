{
  "appId": "com.org.desktop",
  "buildDependenciesFromSource": false,
  "directories": {
    "app": "dist/apps/desktop",
    "output": "dist/packages"
  },
  "extends": null,
  "extraMetadata": {
    "main": "main.js"
  },

  "files": [
    {
      "filter": ["**/*", "!node_modules/**"],
      "from": ".",
      "to": "."
    },
    {
      "filter": ["**/*"],
      "from": "../browser",
      "to": "browser"
    }
  ],
  "linux": {
    "category": "Utility",
    "icon": "apps/desktop/src/assets/icon.png",
    "target": ["AppImage", "deb"]
  },
  "mac": {
    "category": "public.app-category.productivity",
    "icon": "apps/desktop/src/assets/icon.icns",
    "target": ["dmg", "zip"]
  },
  "npmRebuild": false,
  "nsis": {
    "allowToChangeInstallationDirectory": true,
    "oneClick": false
  },
  "productName": "Desktop App",
  "win": {
    "icon": "apps/desktop/src/assets/icon.ico",
    "target": ["nsis", "portable"]
  }
}
