{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": ".",
    "declaration": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "lib": ["es2020", "dom"],
    "module": "esnext",
    "moduleResolution": "node",
    "paths": {
      "@no-paper-needed/components/button": ["libs/components/button/src/index.ts"],
      "@no-paper-needed/components/footer": ["libs/components/footer/src/index.ts"],
      "@no-paper-needed/components/header": ["libs/components/header/src/index.ts"],
      "@no-paper-needed/components/label": ["libs/components/label/src/index.ts"],
      "@no-paper-needed/components/note": ["libs/components/note/src/index.ts"],
      "@no-paper-needed/components/searchbar": [
        "libs/components/searchbar/src/index.ts"
      ],
      "@no-paper-needed/components/stepper-dialog": [
        "libs/components/stepper-dialog/src/index.ts"
      ],
      "@no-paper-needed/components/text": ["libs/components/text/src/index.ts"],
      "@no-paper-needed/components/toolbar": [
        "libs/components/toolbar/src/index.ts"
      ],
      "@no-paper-needed/shared/interfaces": [
        "libs/shared/interfaces/src/index.ts"
      ],
      "@no-paper-needed/shared/locale": ["libs/shared/locale/src/index.ts"],
      "@no-paper-needed/shared/theme": ["libs/shared/theme/src/index.ts"],
      "@no-paper-needed/shared/tokens": ["libs/shared/tokens/src/index.ts"]
    },
    "rootDir": ".",
    "skipDefaultLibCheck": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "target": "es2015"
  },
  "exclude": ["node_modules", "tmp"]
}
