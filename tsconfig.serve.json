{
  "compilerOptions": {
    "outDir": "./dist/apps/electron",
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2022",
    "types": ["node"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "declaration": false,
    "allowJs": true
  },
  "include": ["apps/electron/src/**/*.ts"],
  "exclude": ["apps/electron/**/*.spec.ts", "node_modules"]
}
