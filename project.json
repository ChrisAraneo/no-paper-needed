{
  "name": "root",
  "projectType": "library",
  "root": ".",
  "sourceRoot": ".",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsc -p tsconfig.serve.json",
          "nx build browser --configuration=production"
        ],
        "parallel": false
      },
      "outputs": ["{workspaceRoot}/dist"]
    },
    "chores": {
      "dependsOn": ["lint:fix", "format"],
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'Chores completed'"
      }
    },
    "e2e": {
      "dependsOn": ["build"],
      "executor": "nx:run-commands",
      "options": {
        "command": "nx e2e browser-e2e"
      }
    },
    "e2e:show-trace": {
      "executor": "nx:run-commands",
      "options": {
        "command": "playwright show-trace apps/browser-e2e/tracing/trace.zip"
      }
    },
    "format": {
      "cache": true,
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "sort-package-json \"**/package.json\"",
          "prettier --write **/*.{json,ts,html,scss}"
        ],
        "parallel": false
      },
      "outputs": []
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "eslintConfig": "eslint.config.mjs",
        "lintFilePatterns": [
          "./*.json",
          "./*.mjs",
          "./.vscode/*.json",
          "./.prettierrc.json",
          "./tools/**/*.json",
          "./tools/**/*.js",
          "./tools/**/*.ts"
        ]
      }
    },
    "lint:fix": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nx run-many --target=lint --all --fix"
      }
    },
    "postinstall": {
      "executor": "nx:run-commands",
      "options": {
        "command": "electron-builder install-app-deps"
      }
    },
    "release": {
      "dependsOn": ["build"],
      "executor": "nx:run-commands",
      "options": {
        "command": "electron-builder build --publish=never"
      },
      "outputs": ["{workspaceRoot}/release"]
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "nx serve browser",
          "tsc -p tsconfig.serve.json && wait-on http://localhost:4200 && electron . --serve"
        ],
        "parallel": true
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nx test browser"
      }
    },
    "test:watch": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nx test browser --watch"
      }
    }
  }
}
