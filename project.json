{
  "name": "root",
  "projectType": "library",
  "root": ".",
  "sourceRoot": ".",
  "targets": {
    "build": {
      "dependsOn": ["electron:serve-tsc"],
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "nx build browser --configuration=production"
        ]
      },
      "outputs": ["{workspaceRoot}/dist"]
    },
    "chores": {
      "dependsOn": ["lint:fix", "format"],
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'Chores completed'"
      }
    },
    "e2e": {
      "dependsOn": ["web:prod"],
      "executor": "nx:run-commands",
      "options": {
        "command": "nx e2e browser-e2e"
      }
    },
    "e2e:show-trace": {
      "executor": "nx:run-commands",
      "options": {
        "command": "playwright show-trace apps/browser-e2e/tracing/trace.zip"
      }
    },
    "electron:build": {
      "dependsOn": ["electron:serve-tsc", "web:prod"],
      "executor": "nx:run-commands",
      "options": {
        "command": "electron-builder build --publish=never"
      },
      "outputs": ["{workspaceRoot}/release"]
    },
    "electron:local": {
      "dependsOn": ["web:dev"],
      "executor": "nx:run-commands",
      "options": {
        "command": "electron ."
      }
    },
    "electron:serve": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "nx serve browser",
          "nx run electron:serve-tsc"
        ],
        "parallel": true
      }
    },
    "electron:serve-tsc": {
      "cache": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p tsconfig.serve.json"
      },
      "outputs": ["{workspaceRoot}/dist/apps/electron"]
    },
    "format": {
      "cache": true,
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "sort-package-json \"**/package.json\"",
          "prettier --write **/*.{json,ts,html,scss}"
        ],
        "parallel": false
      },
      "outputs": []
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "eslintConfig": "eslint.config.mjs",
        "lintFilePatterns": [
          "./*.json",
          "./*.mjs",
          "./.vscode/*.json",
          "./.prettierrc.json",
          "./tools/**/*.json",
          "./tools/**/*.js",
          "./tools/**/*.ts"
        ]
      }
    },
    "lint:fix": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nx run-many --target=lint --all --fix"
      }
    },
    "postinstall": {
      "executor": "nx:run-commands",
      "options": {
        "command": "electron-builder install-app-deps"
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "nx serve browser",
          "nx serve electron"
        ],
        "parallel": true
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nx test browser"
      }
    },
    "test:watch": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nx test browser --watch"
      }
    },
    "version": {
      "executor": "nx:run-commands",
      "options": {
        "command": "conventional-changelog -i CHANGELOG.md -s -r 0 && git add CHANGELOG.md"
      }
    },
    "web:dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nx serve browser"
      }
    },
    "web:prod": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nx build browser --configuration=production"
      },
      "outputs": ["{workspaceRoot}/dist/apps/browser"]
    }
  }
}
