{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "footer",
  "prefix": "npn",
  "projectType": "library",
  "sourceRoot": "libs/shared/footer/src",
  "tags": [],
  "targets": {
    "build-storybook": {
      "executor": "@storybook/angular:build-storybook",
      "options": {
        "browserTarget": "browser:build:development",
        "compodoc": false,
        "configDir": "libs/shared/footer/.storybook",
        "outputDir": "dist/storybook/footer",
        "tsConfig": "libs/shared/footer/.storybook/tsconfig.json"
      }
    },
    "chores": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["nx run footer:lint:fix", "nx run footer:format"],
        "parallel": false
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prettier --write \"libs/shared/footer/\""
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "lint:fix": {
      "executor": "@nx/eslint:lint",
      "options": {
        "fix": true
      }
    },
    "storybook": {
      "executor": "@storybook/angular:start-storybook",
      "options": {
        "browserTarget": "browser:build:development",
        "compodoc": false,
        "configDir": "libs/shared/footer/.storybook",
        "port": 6006,
        "tsConfig": "libs/shared/footer/.storybook/tsconfig.json"
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "options": {
        "config": "libs/shared/footer/vite.config.mts"
      }
    }
  }
}
