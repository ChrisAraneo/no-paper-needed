{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "text",
  "prefix": "npn",
  "projectType": "library",
  "sourceRoot": "libs/shared/text/src",
  "tags": [],
  "targets": {
    "chores": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["nx run text:lint:fix", "nx run text:format"],
        "parallel": false
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prettier --write \"libs/shared/text/\""
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "lint:fix": {
      "executor": "@nx/eslint:lint",
      "options": {
        "fix": true
      }
    }
  }
}
