{
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "outDir": "../../../dist/out-tsc",
    "types": []
  },
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.js",
    "src/**/*.spec.js"
  ],
  "extends": "./tsconfig.json",
  "include": ["src/**/*.ts"]
}
