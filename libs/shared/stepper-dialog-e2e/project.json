{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "stepper-dialog-e2e",
  "projectType": "application",
  "sourceRoot": "libs/shared/stepper-dialog-e2e/src",
  "implicitDependencies": ["stepper-dialog"],
  "targets": {
    "e2e": {
      "executor": "@nx/playwright:playwright",
      "options": {
        "config": "libs/shared/stepper-dialog-e2e/playwright.config.ts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "lint:fix": {
      "executor": "@nx/eslint:lint",
      "options": {
        "fix": true
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prettier --write \"libs/shared/stepper-dialog-e2e/\""
      }
    },
    "chores": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "nx run stepper-dialog-e2e:lint:fix",
          "nx run stepper-dialog-e2e:format"
        ],
        "parallel": false
      }
    }
  }
}
