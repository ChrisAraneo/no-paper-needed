{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "searchbar-e2e",
  "projectType": "application",
  "sourceRoot": "libs/shared/searchbar-e2e/src",
  "implicitDependencies": ["searchbar"],
  "targets": {
    "e2e": {
      "executor": "@nx/playwright:playwright",
      "options": {
        "config": "libs/shared/searchbar-e2e/playwright.config.ts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "lint:fix": {
      "executor": "@nx/eslint:lint",
      "options": {
        "fix": true
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prettier --write \"libs/shared/searchbar-e2e/\""
      }
    },
    "chores": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "nx run searchbar-e2e:lint:fix",
          "nx run searchbar-e2e:format"
        ],
        "parallel": false
      }
    }
  }
}
